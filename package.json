{
  "name": "agentic-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-first repository scaffolding: coupling rules, generated contracts, CI gates and a measured state timeline.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gate": "node tools/agentic/gate.mjs",
    "gate:plan": "node tools/agentic/gate.mjs --plan",
    "contracts": "node tools/agentic/contracts.mjs",
    "contracts:check": "node tools/agentic/contracts.mjs --check",
    "invariants": "node tools/agentic/invariants.mjs",
    "test": "node --test tools/agentic/**/*.test.mjs",
    "verify": "npm run contracts:check && npm run invariants && npm test && npm run gate",
    "state": "node tools/agentic/state.mjs",
    "state:snapshot": "node tools/agentic/state.mjs snapshot",
    "mutate": "stryker run",
    "mutate:quick": "stryker run --mutate tools/agentic/lib/glob.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0"
  }
}
