{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "mutate": [
    "tools/agentic/lib/**/*.mjs",
    "!tools/agentic/lib/**/*.test.mjs"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --test-timeout=15000 'tools/agentic/**/*.test.mjs'"
  },
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "concurrency": 8,
  "timeoutMS": 25000,
  "coverageAnalysis": "off"
}
